rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function profileKeysAreValid() {
      return request.resource.data.keys().hasOnly([
        'displayName',
        'email',
        'createdAt',
        'locale',
        'photoUrl'
      ]);
    }

    function profileDataIsValid() {
      return (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
        && (!('email' in request.resource.data) || request.resource.data.email is string)
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp)
        && (!('locale' in request.resource.data) || request.resource.data.locale in ['en', 'km', 'zh'])
        && (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl is string);
    }

    function cartItemIsValid(itemId) {
      return request.resource.data.keys().hasOnly(['productId', 'variantId', 'quantity'])
        && request.resource.data.productId is string
        && request.resource.data.variantId is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && itemId == request.resource.data.productId + '__' + request.resource.data.variantId;
    }

    function wishlistItemIsValid(productId) {
      return request.resource.data.keys().hasOnly(['productId'])
        && request.resource.data.productId == productId;
    }

    function orderIsValid(orderId) {
      return request.resource.data.keys().hasOnly(['id', 'placedAt', 'total', 'status', 'items'])
        && request.resource.data.id == orderId
        && request.resource.data.placedAt is timestamp
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status is string
        && request.resource.data.items is list;
    }

    function addressIsValid(addressId) {
      return request.resource.data.keys().hasOnly([
        'id',
        'fullName',
        'street',
        'city',
        'postalCode',
        'phone',
        'isDefault'
      ])
        && request.resource.data.id == addressId
        && request.resource.data.fullName is string
        && request.resource.data.street is string
        && request.resource.data.city is string
        && request.resource.data.postalCode is string
        && request.resource.data.phone is string
        && request.resource.data.isDefault is bool;
    }

    function cardIsValid(cardId) {
      return request.resource.data.keys().hasOnly([
        'id',
        'cardholderName',
        'cardNumber',
        'expiryDate',
        'brand',
        'themeColor'
      ])
        && request.resource.data.id == cardId
        && request.resource.data.cardholderName is string
        && request.resource.data.cardNumber is string
        && request.resource.data.expiryDate is string
        && request.resource.data.brand is string
        && request.resource.data.themeColor is int;
    }

    function notificationIsValid(notificationId) {
      return request.resource.data.keys().hasOnly([
        'id',
        'title',
        'body',
        'createdAt',
        'kind',
        'isRead'
      ])
        && request.resource.data.id == notificationId
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.kind in ['order', 'promo', 'product', 'system']
        && request.resource.data.isRead is bool;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && profileKeysAreValid() && profileDataIsValid();

      match /bag/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && cartItemIsValid(itemId);
      }

      match /wishlist/{productId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && wishlistItemIsValid(productId);
      }

      match /orders/{orderId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && orderIsValid(orderId);
      }

      match /addresses/{addressId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && addressIsValid(addressId);
      }

      match /cards/{cardId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && cardIsValid(cardId);
      }

      match /notifications/{notificationId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && notificationIsValid(notificationId);
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
