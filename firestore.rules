rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Global Helper Functions ──────────────────────────────────────────────
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Checks if the user has the 'admin' role in their user document
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Collection Rules ─────────────────────────────────────────────────────

    // Users and their subcollections
    match /users/{uid} {
      // Admins can read any user profile; owners can read their own
      allow read: if isOwner(uid) || isAdmin();
      
      // Only owners can update their own basic profile data (excluding roles)
      allow create, update: if isOwner(uid) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      
      // Admins have full control over user documents (e.g., to promote to admin)
      allow write: if isAdmin();

      // Subcollections (Bag, Wishlist, Orders, etc.)
      match /{allSubcollections=**} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid) || isAdmin();
      }
    }

    // Products Catalog
    match /products/{productId} {
      // Anyone (even guest) can view products
      allow read: if true;
      // Only admins can add, edit, or delete products
      allow write: if isAdmin();
    }

    // Global Metadata / App Settings
    match /metadata/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
