PORT=4000
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_SERVICE_ACCOUNT_PATH=./google-service.json

# Cloudflare R2 (profile photos — free tier, no Firebase Storage upgrade needed)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=appletech-profiles
# Public URL: enable R2 public bucket access or attach a custom domain
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
