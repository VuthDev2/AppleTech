rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ── Helper Functions ─────────────────────────────────────────────────────
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Checks user role in Firestore for admin access
    function isAdmin() {
      return isAuthenticated() && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Storage Path Rules ───────────────────────────────────────────────────

    // User Profile Pictures
    match /users/{uid}/profile/{allPaths=**} {
      allow read: if isAuthenticated(); // Allow users to see each other's avatars
      allow write: if isOwner(uid) || isAdmin();
    }

    // Product Images
    match /products/{allPaths=**} {
      allow read: if true; // Publicly viewable product catalog images
      allow write: if isAdmin();
    }

    // Order Attachments (Invoices, Receipts)
    match /users/{uid}/orders/{allPaths=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Default Deny
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
